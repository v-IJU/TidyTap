# Copy this file to .env.local, then fill in ONLY the section for the
# provider you're using. Restart `npm run dev` after any change here —
# Next.js only reads .env.local on server startup.

# -----------------------------------------------------------------------
# Pick ONE: none | groq | gemini
# -----------------------------------------------------------------------
AI_PROVIDER=none

# --- groq --------------------------------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional override. Groq's open-weight vision lineup changes often —
# check https://console.groq.com/docs/models if this model is retired.
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# --- gemini --------------------------------------------------------------
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional override. Check https://ai.google.dev/gemini-api/docs/models
# if this model is retired.
GEMINI_VISION_MODEL=gemini-3.5-flash-lite


